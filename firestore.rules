rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/state/{documentId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion >= 3
        && request.resource.data.revision is int
        && request.resource.data.revision >= 0
        && request.resource.data.payload is map;
    }

    match /users/{uid}/backups/{backupId} {
      allow read, create, delete: if signedInAs(uid);
      allow update: if false;
    }

    // AI teacher records are written only by the trusted Cloud Function.
    // The authenticated parent may read their own summaries and usage.
    match /users/{uid}/teacherSessions/{sessionId} {
      allow read: if signedInAs(uid);
      allow write: if false;
    }

    match /users/{uid}/teacherUsage/{monthId} {
      allow read: if signedInAs(uid);
      allow write: if false;
    }

    match /users/{uid}/teacherRate/{dayId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
